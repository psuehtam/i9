# Copy to .env. Never commit real credentials.
# Local preview defaults to SQLite. Docker Compose supplies DATABASE_URL.
# Generate different long random values before using outside your computer.
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_TO_A_RANDOM_LONG_VALUE
# Set true only when you intend to download official SENATRAN files.
ALLOW_SOURCE_DOWNLOAD=false
I9_UPDATES_PAUSED=true
I9_MAX_DOWNLOAD_BYTES=500000000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional role credentials. Use long unique random keys; never commit real values.
# Roles: analyst, data_engineer, authorized_vehicle_lookup, partner, admin.
# Partner has public access only until an authorized sharing agreement is configured.
I9_ROLE_TOKENS=[]
# Daily source check while the API is running. Disable when using Airflow instead.
I9_SCHEDULER_ENABLED=false
